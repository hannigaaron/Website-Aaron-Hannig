# Netlify: Zwischenspeichern und Sicherheitskopfzeilen.
# Schriften und Bibliotheken aendern sich nie -> ein Jahr. Bilder eine Woche.
# HTML, CSS und Skript bleiben bei Netlifys Standard (immer frisch geprueft),
# damit Aenderungen sofort ankommen.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=604800
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
/llms.txt
  Content-Type: text/plain; charset=utf-8
