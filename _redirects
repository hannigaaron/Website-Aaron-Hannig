# Alte Adressen der Wix-Seite auf die neuen Ziele umleiten (Netlify-Format).
# 301 = dauerhaft, damit Google die Adresse uebernimmt statt beide zu fuehren.
/impressum      /impressum.html     301
/datenschutz    /datenschutz.html   301
/agb            /agb.html           301
/kontakt        /#kontakt           301
/ueber-mich     /#coach             301
/about          /#coach             301
/preise         /#coaching          301
/blog           /                   301
/blog/*         /                   301
# Fuer alles Uebrige greift 404.html — Netlify liefert sie automatisch aus.
# Eine Sammelumleitung /* -> / wird von Netlify verworfen, weil sie fuer die
# Startseite selbst eine Schleife waere.
